# ── Dependencies ─────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Environment files (never commit secrets) ─────────────────
.env
.env.local
.env.production
.env*.local
backend/.env
frontend/.env.local

# ── Next.js build output ─────────────────────────────────────
frontend/.next/
frontend/out/

# ── Prisma ───────────────────────────────────────────────────
# migration files should be committed — only exclude generated files
backend/prisma/generated/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS & editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
*.suo
*.user

# ── TypeScript build info ────────────────────────────────────
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# ── Misc ─────────────────────────────────────────────────────
.vercel
.railway
