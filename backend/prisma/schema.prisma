// ============================================================
// S2R2 Inventory Management — Prisma Schema
// Database: PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Users ─────────────────────────────────────────────────────
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("users")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
  USER
}

// ── Raw Materials ─────────────────────────────────────────────
model RawMaterial {
  id          Int      @id @default(autoincrement())
  name        String   @unique          // unique so seed can upsert by name
  category    String
  description String?
  quantity    Float    @default(0)
  unit        String   @default("pcs")
  supplier    String?
  location    String?
  minStock    Float    @default(0) @map("min_stock")
  price       Float    @default(0)
  lastUpdated DateTime @default(now()) @map("last_updated")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  // BOM relation — this raw material can appear in many BOMs
  bomEntries BillOfMaterials[]

  @@map("raw_materials")
}

// ── Finished Products ─────────────────────────────────────────
model FinishedProduct {
  id        Int                   @id @default(autoincrement())
  name      String                @unique       // unique so seed can upsert by name
  qty       Float                 @default(0)
  unit      String                @default("Box")
  category  String                @default("Finished Products")
  location  String?
  supplier  String?
  minStock  Float                 @default(0) @map("min_stock")
  price     Float                 @default(0)
  status    FinishedProductStatus @default(ACTIVE)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt      @map("updated_at")

  // BOM relation — a finished product has a list of required raw materials
  bomEntries BillOfMaterials[]

  @@map("finished_products")
}

enum FinishedProductStatus {
  ACTIVE
  HOLD
}

// ── Bill of Materials ─────────────────────────────────────────
// Maps which raw materials (and how many) are needed to produce
// one unit of a finished product.
model BillOfMaterials {
  id                Int             @id @default(autoincrement())
  finishedProductId Int             @map("finished_product_id")
  rawMaterialId     Int             @map("raw_material_id")
  quantityRequired  Float           @default(1) @map("quantity_required")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt      @map("updated_at")

  finishedProduct   FinishedProduct @relation(fields: [finishedProductId], references: [id], onDelete: Cascade)
  rawMaterial       RawMaterial     @relation(fields: [rawMaterialId],     references: [id], onDelete: Cascade)

  @@unique([finishedProductId, rawMaterialId])
  @@map("bill_of_materials")
}

// ── Inventory Transactions ────────────────────────────────────
// Audit log of every stock movement — INWARD, OUTWARD, MANUFACTURE.
model InventoryTransaction {
  id              Int             @id @default(autoincrement())
  transactionType TransactionType @map("transaction_type")
  itemType        ItemType        @map("item_type")
  itemId          Int             @map("item_id")
  itemName        String          @map("item_name")   // denormalised for display
  quantity        Float
  note            String?
  performedBy     String          @map("performed_by") // username — denormalised
  createdAt       DateTime        @default(now())      @map("created_at")

  @@map("inventory_transactions")
}

enum TransactionType {
  INWARD
  OUTWARD
  MANUFACTURE
}

enum ItemType {
  RAW_MATERIAL
  FINISHED_PRODUCT
}

// ── Clients ───────────────────────────────────────────────────
model Client {
  id          Int          @id @default(autoincrement())
  clientName  String       @map("client_name")
  companyName String?      @map("company_name")
  phone       String?
  email       String?      @unique
  address     String?
  gstNo       String?      @map("gst_no")
  status      ClientStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt      @map("updated_at")

  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

// ── IoT Devices ───────────────────────────────────────────────
model IoTDevice {
  id        Int             @id @default(autoincrement())
  deviceId  String          @unique @map("device_id")
  name      String
  type      String?
  location  String?
  status    IoTDeviceStatus @default(ONLINE)
  lastPing  DateTime?       @map("last_ping")
  metadata  Json?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt      @map("updated_at")

  @@map("iot_devices")
}

enum IoTDeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

// ── Activity Log ──────────────────────────────────────────────
model ActivityLog {
  id        Int      @id @default(autoincrement())
  module    String
  label     String
  action    String
  username  String   @default("system")
  eventTime DateTime @default(now()) @map("event_time")

  @@map("activity_logs")
}
