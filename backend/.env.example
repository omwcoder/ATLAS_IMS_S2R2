# HOW TO USE
# ──────────────────────────────────────────────────────────────
# 1. Copy this file:   cp .env.example .env
# 2. Fill in values marked ← CHANGE THIS
# 3. Never commit the filled .env to Git (it is in .gitignore)
# ─────────────────────────────────────────────────────────────────

# ── Ownership Signature (DO NOT MODIFY) ──────────────────────
OWNER_SIG=ab33e31dfa52e6d0087078fd205645d09832a8048cc09426c8e759bc8f131ad4

# ── Database (Local PostgreSQL) ───────────────────────────────
# Default local setup created by setup-local-db.sql / create-local-db.ps1
DATABASE_URL="postgresql://s2r2_user:s2r2pass@localhost:5432/s2r2_inventory"

# ── Server ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Security ──────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="s2r2IOT"   # ← CHANGE THIS in production

# ── Frontend URL (CORS) ───────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ── Groq AI (Civi AI — optional) ─────────────────────────────
# Get a free key at https://console.groq.com
# Leave blank to disable AI narrative — app works without it
GROQ_API_KEY=

# ── Trial License ─────────────────────────────────────────────
